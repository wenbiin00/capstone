# Serial port your Arduino is on
# Mac:     /dev/cu.usbmodem1101  (run: ls /dev/cu.usb* to find yours)
# Linux:   /dev/ttyUSB0 or /dev/ttyACM0
# Windows: COM3
SERIAL_PORT=/dev/cu.usbmodem1101

BAUD_RATE=9600

# Must match what's running in aewrs-backend
API_BASE_URL=http://localhost:3000/api

# The locker_id in your database for this physical unit
LOCKER_ID=1
